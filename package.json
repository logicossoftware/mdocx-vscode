{
  "name": "mdocx-vscode",
  "displayName": "MDOCX",
  "description": "Preview, edit, and manage MDOCX (MarkDown Open Container eXchange) files in VS Code.",
  "version": "0.2.0",
  "publisher": "logicossoftware",
  "author": {
    "name": "MHJ Wiggers / Logicos Software"
  },
  "license": "MIT",
  "icon": "images/icon.png",
  "galleryBanner": {
    "color": "#1e1e1e",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/logicossoftware/mdocx-vscode.git"
  },
  "bugs": {
    "url": "https://github.com/logicossoftware/mdocx-vscode/issues"
  },
  "homepage": "https://github.com/logicossoftware/mdocx-vscode#readme",
  "keywords": [
    "mdocx",
    "markdown",
    "preview",
    "container",
    "document",
    "media"
  ],
  "engines": {
    "vscode": "^1.92.0"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "preview": true,
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "mdocx.createNew",
        "title": "Create New MDOCX File",
        "category": "MDOCX"
      },
      {
        "command": "mdocx.createFromFolder",
        "title": "Create MDOCX from Folder",
        "category": "MDOCX"
      },
      {
        "command": "mdocx.extractToFolder",
        "title": "Extract MDOCX to Folder",
        "category": "MDOCX"
      },
      {
        "command": "mdocx.exportHtml",
        "title": "Export MDOCX as HTML",
        "category": "MDOCX"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "mdocx.createNew",
          "when": "explorerResourceIsFolder",
          "group": "navigation@10"
        },
        {
          "command": "mdocx.createFromFolder",
          "when": "explorerResourceIsFolder",
          "group": "navigation@11"
        },
        {
          "command": "mdocx.extractToFolder",
          "when": "resourceExtname == .mdocx",
          "group": "navigation@10"
        },
        {
          "command": "mdocx.exportHtml",
          "when": "resourceExtname == .mdocx",
          "group": "navigation@11"
        }
      ]
    },
    "configuration": {
      "title": "MDOCX",
      "properties": {
        "mdocx.maxInlineMediaBytes": {
          "type": "number",
          "default": 26214400,
          "minimum": 1,
          "description": "Maximum size (bytes) of a single embedded media item to inline into the preview as a data URI. Larger items will not be inlined."
        },
        "mdocx.confirmDelete": {
          "type": "boolean",
          "default": true,
          "description": "Ask for confirmation before deleting markdown files or media from an MDOCX container."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "mdocx.preview",
        "displayName": "MDOCX Preview",
        "selector": [
          {
            "filenamePattern": "*.mdocx"
          }
        ],
        "priority": "default"
      }
    ]
  },
  "scripts": {
    "compile": "node esbuild.mjs",
    "compile:tsc": "tsc -p ./",
    "watch": "node esbuild.mjs --watch",
    "sample:generate": "node ./scripts/generate-sample.mjs",
    "lint": "node ./scripts/noop-lint.js",
    "vscode:prepublish": "npm run compile -- --production"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.92.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.3"
  },
  "dependencies": {
    "marked": "^12.0.2",
    "ts-mdocx": "^0.2.0"
  }
}
